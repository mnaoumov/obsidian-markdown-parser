{
  "name": "obsidian-markdown-parser-metadata",
  "version": "0.1.0",
  "private": true,
  "description": "The CachedMetadata Obsidian's metadata worker posts for a document, and the remark-parse 8 engine it is built from, without the editor or CodeMirror dependencies.",
  "license": "UNLICENSED",
  "author": "Michael Naumov",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entries/metadata.d.ts",
      "default": "./dist/entries/metadata.js"
    },
    "./remark": {
      "types": "./dist/entries/remark.d.ts",
      "default": "./dist/entries/remark.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "character-entities-legacy": "^3.0.0",
    "character-reference-invalid": "^2.0.1",
    "decode-named-character-reference": "^1.3.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
