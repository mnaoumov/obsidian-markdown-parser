{
  "name": "obsidian-markdown-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Incremental parser for Obsidian-flavoured markdown, built on @lezer/markdown.",
  "keywords": [],
  "homepage": "https://github.com/mnaoumov/obsidian-markdown-parser#readme",
  "bugs": {
    "url": "https://github.com/mnaoumov/obsidian-markdown-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnaoumov/obsidian-markdown-parser.git"
  },
  "license": "UNLICENSED",
  "author": "Michael Naumov",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./editor": {
      "types": "./dist/lib/entries/editor.d.ts",
      "default": "./dist/lib/entries/editor.js"
    },
    "./lezer": {
      "types": "./dist/lib/entries/lezer.d.ts",
      "default": "./dist/lib/entries/lezer.js"
    },
    "./markdown-it": {
      "types": "./dist/lib/entries/markdown-it.d.ts",
      "default": "./dist/lib/entries/markdown-it.js"
    },
    "./mdast": {
      "types": "./dist/lib/entries/mdast.d.ts",
      "default": "./dist/lib/entries/mdast.js"
    },
    "./metadata": {
      "types": "./dist/lib/entries/metadata.d.ts",
      "default": "./dist/lib/entries/metadata.js"
    },
    "./remark": {
      "types": "./dist/lib/entries/remark.d.ts",
      "default": "./dist/lib/entries/remark.js"
    },
    "./syntax": {
      "types": "./dist/lib/entries/syntax.d.ts",
      "default": "./dist/lib/entries/syntax.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "THIRD-PARTY-NOTICES.md"
  ],
  "workspaces": [
    "packages/metadata"
  ],
  "scripts": {
    "build": "jiti scripts/build.ts",
    "build:compile": "jiti scripts/build-compile.ts",
    "commit": "jiti scripts/commit.ts",
    "export:test-cases": "jiti scripts/export-test-cases.ts",
    "format": "jiti scripts/format.ts",
    "format:check": "jiti scripts/format-check.ts",
    "lint": "jiti scripts/lint.ts",
    "lint:fix": "jiti scripts/lint-fix.ts",
    "lint:md": "jiti scripts/lint-md.ts",
    "lint:md:fix": "jiti scripts/lint-md-fix.ts",
    "link-cases": "jiti scripts/link-cases.ts",
    "link-parity": "jiti scripts/link-parity.ts",
    "mode-judge": "jiti scripts/mode-judge.ts",
    "oracle:differential": "jiti scripts/release-differential.ts",
    "oracle:drift": "jiti scripts/oracle-drift.ts",
    "oracle:reference": "jiti scripts/reference-oracle.ts",
    "oracle:refresh": "jiti scripts/oracle-refresh.ts",
    "self-check": "jiti scripts/self-check.ts",
    "special-names": "jiti scripts/special-names.ts",
    "prepare": "jiti scripts/prepare.ts",
    "spellcheck": "jiti scripts/spellcheck.ts",
    "test": "jiti scripts/test.ts",
    "test:coverage": "jiti scripts/test-coverage.ts",
    "test:watch": "jiti scripts/test-watch.ts"
  },
  "overrides": {
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.17.1",
    "katex": "^0.19.0",
    "obsidian": {
      "@codemirror/view": "$@codemirror/view"
    },
    "type-fest": "^5.10.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/streamparser": "^6.0.0",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@types/mdast": "^4.0.4",
    "character-entities-legacy": "^3.0.0",
    "character-reference-invalid": "^2.0.1",
    "codemirror": "5.64.0",
    "decode-named-character-reference": "^1.3.0",
    "markdown-it": "^15.0.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark": "^4.0.3",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-chunked": "^2.0.1",
    "micromark-util-decode-numeric-character-reference": "^2.0.2",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-encode": "^2.0.1",
    "micromark-util-normalize-identifier": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@mnaoumov/typescript-dev-toolkit": "^3.7.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/commonmark": "^0.27.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "better-typescript-lib": "^2.12.0",
    "commonmark": "0.31.2",
    "cspell": "^10.4.0",
    "czg": "^1.14.0",
    "dprint": "^0.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.3.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "linkinator": "^8.1.0",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.24.0",
    "markdownlint-rule-relative-links": "^5.1.3",
    "micromark-extension-gfm-tagfilter": "^2.0.0",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.14.4",
    "parse5": "^8.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
